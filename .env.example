# Production Docker Compose template. Local development uses built-in defaults.
NODE_ENV=production
# Internal backend listening port and published service ports.
PORT=4000
BACKEND_PORT=4000
FRONTEND_PORT=5173
DATABASE_PORT=5432
CACHE_PORT=6379

POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# Match POSTGRES_* above; URL-encode special characters in credentials.
# "database" and "cache" are internal Docker service names, not public hosts.
DATABASE_URL=postgresql://lms:replace-with-a-strong-database-password@database:5432/lms?schema=public
REDIS_URL=redis://cache:6379
JWT_SECRET=replace-with-a-long-random-secret-before-production

# Public browser-facing URLs: replace localhost with your deployment hostname.
CORS_ORIGIN=http://localhost:5173
# Relative path under /app/apps/backend; Docker mounts persistent storage here.
UPLOAD_DIR=uploads
# Demo users have public passwords: keep disabled on real production instances.
SEED_DEMO_DATA=false
# Embedded during frontend build: rebuild after changing this value.
VITE_API_URL=http://localhost:4000
